# Variables de entorno del Backend.
# Copia este archivo como .env y completa los valores. El archivo .env no se sube a git.
# Todos los valores de este ejemplo son ficticios y seguros de publicar.

# ---------- Obligatorias ----------

# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres aleatorios.
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Base de datos SQLite. La ruta es relativa a prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Origen exacto del Frontend permitido por CORS (sin barra final).
CORS_ORIGIN=http://localhost:5173

# ---------- Opcionales ----------

# Puerto del Backend (por defecto 3000).
PORT=3000

# development, test o production (por defecto development).
NODE_ENV=development

# URL del Frontend para los enlaces de recuperación de contraseña (por defecto http://localhost:5173).
FRONTEND_URL=http://localhost:5173

# Feriados con Nager.Date (servicio público sin claves). true o false (por defecto true).
NAGER_ENABLED=true
# Código de país de 2 letras (por defecto MX).
NAGER_COUNTRY=MX

# Servidor SMTP. Solo se usa si las cinco variables están definidas.
# Si falta alguna y el entorno no es de producción, los correos se escriben
# en la consola del Backend (Bandeja_Local).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Contraseñas de las 11 cuentas demo (opcionales, 8 a 128 caracteres, todas distintas).
# - Vacía en una cuenta nueva: la semilla genera una contraseña aleatoria y la muestra una sola vez.
# - Vacía en una cuenta que ya existe: se conserva su contraseña actual.
# - Definida: la semilla crea o actualiza la cuenta con esa contraseña.
# Son credenciales de demostración: no reutilices contraseñas reales.
DEMO_ADMIN_PASSWORD=
DEMO_DOCTOR_1_PASSWORD=
DEMO_DOCTOR_2_PASSWORD=
DEMO_DOCTOR_3_PASSWORD=
DEMO_NURSE_1_PASSWORD=
DEMO_NURSE_2_PASSWORD=
DEMO_NURSE_3_PASSWORD=
DEMO_NURSE_4_PASSWORD=
DEMO_CLEANING_1_PASSWORD=
DEMO_CLEANING_2_PASSWORD=
DEMO_CLEANING_3_PASSWORD=
